{
"environment": {
        "logging": {
            "console": true,
            "console_level": "INFO",
            "file_level": "INFO"
        },
        "collisions": false,
        "time_limit": 1000,
        "num_runs": 1,
        "ticks_per_second": 1,
        "target_position_swaps": [],
        "post_bifurcation_swap": {
            "pairs": [
                [
                    "static_0.s#0",
                    "static_1.s#0"
                ]
            ],
            "delay_ticks": 1
        },
        "gui": {
            "_id": "2D",
            "on_click": [
                "show_spins", "detection"
            ],
            "view": ["detection"]
        },
        "termination": {
            "type": "proximity",
            "target_ids": [
                "static_0.s#0",
                "static_1.s#0"
            ],
            "radius": 0.05,
            "agent_ids": "any"
        },
        "arenas": {
            "arena_0": {
                "random_seed": 81,
                "radius": 1,
                "_id": "square",
                "color": "gray"
            }
        },
        "objects": {
            "static_0": {
                "number": [1],
                "position": [[0.433, -0.25, 0]],
                "_id": "idle",
                "shape": "cylinder",
                "height": 0.2,
                "diameter": 0.05,
                "color": "green",
                "strength": [5.0],
                "uncertainty": [0]
            },
            "static_1": {
                "number": [1],
                "position": [[0.433, 0.25, 0]],
                "_id": "idle",
                "shape": "cylinder",
                "height": 0.2,
                "diameter": 0.05,
                "color": "red",
                "strength": [4.95],
                "uncertainty": [0]
            }    
        },
        "agents": {
            "movable_0": {
                "position": [[0.0,0.00,0]],
                "orientation": [[0, 0, 0]],
                "number": [1],
                "shape": "cylinder",
                "linear_velocity": 0.01,
                "angular_velocity": 10,
                "height": 0.02,
                "diameter": 0.033,
                "color": "blue",
                "ticks_per_second": 1,
                "detection": {
                    "type": "GPS",
                    "range": 5.0,
                    "acquisition_per_second": "inf"
                },
                "moving_behavior": "mean_field",
                "mean_field_model": {
                    "steps_per_tick": 1,
                    "perception_width": 0.2,
                    "perception_global_inhibition": 0.2,
                    "num_neurons": 30,
                    "_comment_readout": "--- readout: how the ring activity z is turned into a heading command and a forward-speed command. ---",
                    "_comment_use_thresholding": "true: only units whose activity exceeds g_threshold contribute to the heading; the rest are silenced. false: every unit contributes to the heading in proportion to its activity, and g_threshold / threshold_readout are ignored.",
                    "_comment_g_threshold": "Activity level a unit must strictly exceed to take part in the heading readout, in the same units as z. Also acts as the 'no bump' test: when no unit exceeds it the agent stops moving.",
                    "_comment_threshold_readout": "How the units that pass g_threshold are combined into a heading. 'weighted': each unit's preferred direction is weighted by its activity, so the heading follows the shape of the bump. 'unweighted': each passing unit weighs exactly 1, so the heading is the plain average of the preferred directions of the active units and depends only on WHICH units are active, not on how active they are.",
                    "_comment_scale_velocity": "true: forward speed is max_absolute_velocity multiplied by a gate chosen by scaling_mode (default 'magnitude' when use_thresholding is true: the length of the readout vector, not clipped; 'norm' when false: L2 norm of z, clipped to [0,1]; 'concentration': angular coherence of the readout in [0,1]). false: constant forward speed of max_absolute_velocity * norm_scale whenever a bump exists, zero otherwise; the readout then only steers.",
                    "_comment_norm_scale": "With scale_velocity false: gain on the constant forward speed (1.0 = full max_absolute_velocity). With scale_velocity true: only used by scaling_mode 'norm', as a gain on the L2 norm before clipping.",
                    "use_thresholding": true,
                    "g_threshold": 0.6,
                    "threshold_readout": "unweighted",
                    "scale_velocity": false,
                    "norm_scale": 1.0,
                    "tau_adapt": 3.2,
                    "g_adapt": 0.0,
                    "num_targets": 2,
                    "num_guards": 0,
                    "target_ids": [
                        "static_0.s#0",
                        "static_1.s#0"
                    ],
                    "guard_ids": [],
                    "guard_decay_rate": 6.0,
                    "kappa": 20,
                    "v": 0.5,
                    "u": 6.2,
                    "sigma": 0.15,
                    "sigma_s": 0.5,
                    "beta": 1.0,
                    "integration_time": 50,
                    "integration_dt": 0.1,
                    "reference": "egocentric",
                    "bifurcation": {
                        "mode": "behavioral",
                        "lambda_threshold": -0.1,
                        "spike_min_separation": 10,
                        "alignment_tolerance_deg":5.0,
                        "alignment_consecutive_ticks": 1,
                        "gradient_window": 5,
                        "gradient_threshold": 0.005
                    }
                }
            }
        }
    }
}
